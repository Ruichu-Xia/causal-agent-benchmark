# Only model evaluation needs credentials. LiteLLM selects the key by the model's provider prefix.
# Uncomment and fill in the key for your provider; never commit .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional: direct Databricks client (Python API).
# DATABRICKS_TOKEN=
# DATABRICKS_HOST=https://your-workspace.databricks.net
