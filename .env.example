# Copy this file to `.env` and fill in what you use. It is loaded automatically during data generation
# (causalagentbench.generation); consuming the shipped test set needs none of this.

# --- LLM provider keys (only the providers your generator/judge models use) ---
# LiteLLM reads these by provider prefix, e.g. model "anthropic/claude-opus-4-8" -> ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- CauseNet grounding dump ---
# Download causenet-precision.jsonl.bz2 from https://causenet.org and point here.
CAUSENET_DUMP=/absolute/path/to/causenet-precision.jsonl.bz2

# --- Databricks AI Gateway (only if using DatabricksClient/DatabricksProposer - agent.clients or
# generation.clients, same gateway either way) ---
# DATABRICKS_TOKEN=
# DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
# DATABRICKS_AI_GATEWAY_BASE_URL=   # optional: overrides the URL computed from DATABRICKS_HOST
